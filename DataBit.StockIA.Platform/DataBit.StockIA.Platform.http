@host = http://localhost:5000/api/v1

### Sign in (demo Administrator)
# @name signIn
POST {{host}}/authentication/sign-in
Content-Type: application/json

{ "email": "admin@databitecorp.com", "password": "stockia123" }

### Supplies
GET {{host}}/inventory-items
Authorization: Bearer {{signIn.response.body.token}}

### Sell one Ensalada César con Pollo (recipe 3)
POST {{host}}/sales
Authorization: Bearer {{signIn.response.body.token}}
Content-Type: application/json

{ "recipeId": 3, "quantity": 1 }

### Generate a demand forecast (ML)
POST {{host}}/demand-forecasts
Authorization: Bearer {{signIn.response.body.token}}
Content-Type: application/json

{ "horizonDays": 7 }

### Register a restaurant (Restaurant Registration — sign-up)
POST {{host}}/restaurant-registrations
Content-Type: application/json

{ "fullName": "Rosa Quispe", "restaurantName": "Picantería Rosa", "email": "rosa@picanteria.pe", "password": "Picante2026" }

### Forgot password: recovery link (IAM — Password Reset Service)
# @name resetRequest
POST {{host}}/authentication/password-reset-requests
Content-Type: application/json

{ "email": "empleado@databitecorp.com" }

### Reset the password with the code of the link (Development shows it in simulatedEmail)
POST {{host}}/authentication/password-resets
Content-Type: application/json

{ "email": "empleado@databitecorp.com", "code": "{{resetRequest.response.body.simulatedEmail.code}}", "newPassword": "Nueva2026" }

### Unlock a member locked by wrong passwords (Administrator)
POST {{host}}/users/2/unlock
Authorization: Bearer {{signIn.response.body.token}}

### Weekly savings (Analytics & Dashboard, Administrator)
GET {{host}}/dashboard/weekly-savings
Authorization: Bearer {{signIn.response.body.token}}
